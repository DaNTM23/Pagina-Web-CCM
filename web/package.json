{
  "name": "ccm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CCM — sistema de cursos sobre Cloudflare (SvelteKit + D1 + R2)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "pruebas": "vitest run",
    "revisar": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:local": "wrangler d1 migrations apply ccm --local",
    "db:remota": "wrangler d1 migrations apply ccm --remote"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0"
  }
}
